#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./tools/r640/switch [--check | --dry-run]

  --check     Validate checkout, host, flake output, and mounted storage only.
  --dry-run   Run the same checks and build the exact r640-0 system closure.
  no option   Prompt for sudo, preserve rollback details, and activate r640-0.

Run from the clean primary Nix Arbor main checkout on host r640-0.
USAGE
}

mode=activate
case "${1:-}" in
  "") ;;
  --check) mode=check ;;
  --dry-run) mode=dry-run ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 2; }

fail() { printf 'r640 switch: %s\n' "$*" >&2; exit 1; }

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd -P)
expected_root=/home/ash/documents/nix-arbor
[[ $repo_root == "$expected_root" ]] || fail "expected primary checkout at $expected_root, found $repo_root"
[[ $(git -C "$repo_root" rev-parse --show-toplevel) == "$repo_root" ]] || fail 'script is not inside the expected Git checkout'
branch=$(git -C "$repo_root" branch --show-current)
[[ $branch == main ]] || fail "expected branch main, found ${branch:-detached}; switch to the reviewed main checkout"
host=$(hostname -s)
[[ $host == r640-0 ]] || fail "host must be r640-0; found $host"
[[ -z $(git -C "$repo_root" status --porcelain) ]] || fail 'checkout is dirty; commit or preserve the changes before activation'
flake_ref="$repo_root#r640-0"
configured_host=$(nix eval --raw "$repo_root#nixosConfigurations.r640-0.config.networking.hostName")
[[ $configured_host == r640-0 ]] || fail "flake output r640-0 declares hostname '$configured_host'"
expected_codex_version=$(nix eval --json "$repo_root#nixosConfigurations.r640-0.config.environment.systemPackages" \
  --apply 'ps: builtins.filter (p: builtins.match "codex-[0-9].*" p.name != null) (builtins.map (p: { inherit (p) name; version = p.version or ""; }) ps)' \
  | jq -er 'if length == 1 then .[0].version else error("expected one NixOS codex package") end')
[[ -n $expected_codex_version ]] || fail 'unable to determine the NixOS Codex package version'
command -v mountpoint >/dev/null || fail 'mountpoint is unavailable'
mountpoint -q /mypool || fail '/mypool is not mounted; refusing a host switch'
command -v zpool >/dev/null || fail 'zpool is unavailable'
zpool list -H mypool >/dev/null 2>&1 || fail 'ZFS pool mypool is unavailable; refusing a host switch'
[[ -d /mypool/docker_data && -d /mypool/nix-build ]] || fail 'expected /mypool/docker_data and /mypool/nix-build are not present'

printf 'Preflight PASS: host=%s branch=%s head=%s\n' \
  "$host" "$branch" "$(git -C "$repo_root" rev-parse --short HEAD)"
printf 'Flake target: %s\n' "$flake_ref"
printf 'NixOS Codex package: %s\n' "$expected_codex_version"
printf 'Storage PASS: /mypool and ZFS pool mypool are ready\n'
if [[ $mode == check ]]; then
  printf 'Check complete; sudo and activation were not used.\n'
  exit 0
fi

if [[ $mode == dry-run ]]; then
  printf 'Building r640-0 system closure without activation...\n'
  nix build --no-link "$repo_root#nixosConfigurations.r640-0.config.system.build.toplevel"
  printf 'Dry-run complete; no sudo or host activation was used.\n'
  exit 0
fi

before_codex='codex not found'
if command -v codex >/dev/null 2>&1; then
  before_codex=$(codex --version | head -n 1)
fi
current_system=$(readlink -f /run/current-system 2>/dev/null || printf 'unavailable')
profile_system=$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || printf 'unavailable')
booted_system=$(readlink -f /run/booted-system 2>/dev/null || printf 'unavailable')
generations=$(nix-env --profile /nix/var/nix/profiles/system --list-generations 2>/dev/null || printf 'unavailable')
recovery_command="sudo nixos-rebuild switch --rollback --flake $flake_ref"
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
rollback_file="/var/lib/nix-arbor-r640-switch/$timestamp.txt"

printf 'Current system: %s\nBooted system:  %s\nSystem profile: %s\n' \
  "$current_system" "$booted_system" "$profile_system"
printf 'Codex before:   %s\n' "$before_codex"
printf 'Rollback note:  %s\nRollback command: %s\n' "$rollback_file" "$recovery_command"
printf 'System generations before switch:\n%s\n' "$generations"
printf 'Sudo may prompt for your password before activation.\n'
sudo -v
sudo install -d -m 0700 /var/lib/nix-arbor-r640-switch
{
  printf 'timestamp_utc=%s\n' "$timestamp"
  printf 'checkout=%s\nbranch=%s\nhead=%s\n' "$repo_root" "$branch" "$(git -C "$repo_root" rev-parse HEAD)"
  printf 'current_system=%s\nbooted_system=%s\nsystem_profile=%s\n' "$current_system" "$booted_system" "$profile_system"
  printf 'codex_before=%s\n' "$before_codex"
  printf 'rollback_command=%s\n' "$recovery_command"
  printf '\nSystem generations before switch:\n%s\n' "$generations"
} | sudo tee "$rollback_file" >/dev/null

sudo nixos-rebuild switch --flake "$flake_ref"

system_codex=/run/current-system/sw/bin/codex
[[ -x $system_codex ]] || fail "activation completed, but $system_codex is missing"
after_codex=$("$system_codex" --version | head -n 1) || fail 'activation completed, but system codex --version failed'
[[ -n $after_codex ]] || fail 'activation completed, but codex --version returned no version'
printf 'Codex after:    %s\n' "$after_codex"
actual_codex_version=${after_codex##* }
[[ $actual_codex_version == "$expected_codex_version" ]] || fail "activated Codex is $actual_codex_version, expected $expected_codex_version"
printf 'Rollback details: %s\n' "$rollback_file"
printf 'Switch completed. Recovery command: %s\n' "$recovery_command"
