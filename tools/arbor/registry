#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: tools/arbor/registry <status|inspect|summary|init-self|restart-check> <r640-0|eVolver>

  status         Check both service units and local-only canary configuration
  inspect        Read the local identity (including an empty Registry)
  summary        Read public identity, record and projection counts
  init-self      Create or verify this host's isolated generation-one root
  restart-check  Restart transport and Registry, then compare the public identity

r640-0 runs locally. eVolver uses the root-evolver SSH alias. Adapter calls
run as arbor-registry. Use a terminal for local sudo password prompts.
USAGE
}
case $#:${1-} in 1:-h|1:--help) usage; exit 0 ;; esac
[[ $# == 2 ]] || { usage >&2; exit 2; }
case $1 in status|inspect|summary|init-self|restart-check) ;; *) usage >&2; exit 2 ;; esac
script=$(dirname -- "${BASH_SOURCE[0]}")/registry-host.sh
case $2 in
  r640-0) exec bash "$script" "$1" r640-0 ;;
  eVolver) exec ssh -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10 root-evolver bash -s -- "$1" eVolver <"$script" ;;
  *) usage >&2; exit 2 ;;
esac
