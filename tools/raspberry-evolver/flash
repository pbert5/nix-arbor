#!/usr/bin/env bash
set -eu
if [[ ${1-} == --help || ${1-} == -h ]]; then
  printf '%s\n' 'Usage: flash [IMAGE DEVICE] [--write]' 'Dry-run is unprivileged; --write performs privileged inspection and requires typed confirmation.'
  exit 0
fi
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$here/flash_impl.py" "$@"
fi
if command -v nix >/dev/null 2>&1; then
  exec nix shell --inputs-from "$here/../.." nixpkgs#python3 --command python3 "$here/flash_impl.py" "$@"
fi
printf '%s\n' 'python3 is required; run in a Nix shell with python3 available.' >&2
exit 1
