#!/usr/bin/env python3
"""Add a public SSH key to selected Arbor users and machines."""
import argparse
from pathlib import Path
import sys

sys.dont_write_bytecode = True
from ssh_grants import ROOT, extra_path, lock_grants, parse_grants, public_key_info, read_snapshot, save_grants

USERS = ['madeline', 'ash']


def select(label, choices):
    print(f'{label} (Enter for all; comma-separated numbers to select):')
    for number, choice in enumerate(choices):
        print(f'  {number}: {choice}')
    value = input('> ').strip()
    if not value:
        return choices
    try:
        indexes = [int(part.strip()) for part in value.split(',')]
        if any(index < 0 or index >= len(choices) for index in indexes):
            raise ValueError
        return [choice for index, choice in enumerate(choices) if index in indexes]
    except ValueError:
        raise ValueError('Invalid selection') from None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=ROOT, help=argparse.SUPPRESS)
    root = parser.parse_args().root
    key = input('Paste a public SSH key: ').strip()
    parts = key.split()
    print(public_key_info(key))
    users = select('Users', USERS)
    hosts = select('Machines', sorted(p.name for p in (root / 'config/machines').iterdir() if p.is_dir() and (p / 'default.nix').is_file()))
    if not hosts:
        raise ValueError('No machines found')
    path = extra_path(root)
    parse_grants(read_snapshot(path))
    print(f"Grant to users {', '.join(users)} on machines {', '.join(hosts)}.")
    if input('Save these grants? [y/N] ').strip().lower() != 'y':
        print('Cancelled.')
        return
    with lock_grants(path):
        snapshot = read_snapshot(path)
        data = parse_grants(snapshot)
        for host in hosts:
            for user in users:
                keys = data.setdefault(host, {}).setdefault(user, [])
                if not any(existing.split()[:2] == parts[:2] for existing in keys):
                    keys.append(key)
        save_grants(path, snapshot, data)
    print(f'Saved {path}. Review, commit, and deploy the Nix configuration to apply it.')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, EOFError, OSError) as error:
        print(f'Error: {error}', file=sys.stderr)
        sys.exit(1)
