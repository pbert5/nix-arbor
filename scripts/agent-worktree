#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  agent-worktree new <task-slug> [agent-name]
  agent-worktree list
  agent-worktree status [<task-slug>]
  agent-worktree remove <task-slug-or-full-branch> [--force]
  agent-worktree prune
  agent-worktree clean [--force]
  agent-worktree cleanup-merged [--force]

Worktrees live beside the primary checkout in ../nix-arbor-worktrees/.
Branches use agent/<agent-name>/<task-slug>.
EOF
}

root=$(git rev-parse --show-toplevel)
common_git_dir=$(git rev-parse --git-common-dir)
case "$common_git_dir" in
  /*) ;;
  *) common_git_dir="$root/$common_git_dir" ;;
esac
primary_root=$(cd "$(dirname "$common_git_dir")" && pwd)
repo_name=$(basename "$primary_root")
workspace_root="$(dirname "$primary_root")/${repo_name}-worktrees"
default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
default_branch=${default_branch#origin/}
default_branch=${default_branch:-main}

slug() {
  local value=$1
  value=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g; s/--*/-/g; s/^-*//; s/-*$//')
  [ -n "$value" ] || { echo "task slug is empty after normalization" >&2; exit 2; }
  printf '%s\n' "$value"
}

branch_for() {
  local task=$1 agent=${2:-${NIX_ARBOR_AGENT:-${USER:-agent}}}
  printf 'agent/%s/%s\n' "$(slug "$agent")" "$(slug "$task")"
}

resolve_branch() {
  local target=$1 branch matches=()
  if [[ "$target" == agent/*/* ]]; then
    git show-ref --verify --quiet "refs/heads/$target" || return 1
    printf '%s\n' "$target"
    return 0
  fi
  while read -r branch; do
    case "$branch" in */"$target") matches+=("$branch") ;; esac
  done < <(git for-each-ref --format='%(refname:short)' 'refs/heads/agent/*/*')
  [ "${#matches[@]}" -eq 1 ] || {
    echo "task is missing or ambiguous; use the full agent/<name>/<task> branch" >&2
    return 1
  }
  printf '%s\n' "${matches[0]}"
}

path_for() { printf '%s/%s\n' "$workspace_root" "${1//\//-}"; }

worktree_line() { git worktree list --porcelain | awk -v b="refs/heads/$1" '$1 == "worktree" {p=$2} $1 == "branch" && $2 == b {print p}'; }

is_dirty() { [ -n "$(git -C "$1" status --porcelain --untracked-files=all --ignored 2>/dev/null)" ]; }

remove_branch_safely() {
  local branch=$1 base=${2:-$default_branch}
  git merge-base --is-ancestor "$branch" "$base" 2>/dev/null
}

cmd=${1:-help}; shift || true
case "$cmd" in
  new)
    task=${1:?task slug required}; agent=${2:-${NIX_ARBOR_AGENT:-${USER:-agent}}}
    branch=$(branch_for "$task" "$agent"); path=$(path_for "$branch")
    [ ! -e "$path" ] || { echo "worktree path already exists: $path" >&2; exit 1; }
    git show-ref --verify --quiet "refs/heads/$branch" && { echo "branch already exists: $branch" >&2; exit 1; }
    mkdir -p "$workspace_root"
    base=$default_branch
    git show-ref --verify --quiet "refs/heads/$base" || base=HEAD
    git worktree add -b "$branch" "$path" "$base"
    # Initialize direct submodules. Some reference repositories contain
    # historical gitlinks without a .gitmodules mapping, so recursive mode
    # would fail before this worktree is usable.
    if ! git -C "$path" submodule update --init; then
      echo "Submodule initialization failed; removing only the new worktree." >&2
      git worktree remove --force "$path"
      git branch -D "$branch"
      exit 1
    fi
    printf 'Created %s\n' "$path"
    printf 'Branch: %s\n' "$branch"
    ;;
  list) git worktree list --verbose ;;
  status)
    if [ "$#" -gt 0 ]; then
      branch=$(resolve_branch "$1") || exit 1
      path=$(worktree_line "$branch")
      [ -n "${path:-}" ] || { echo "branch is not checked out: $branch" >&2; exit 1; }
      git -C "$path" status --short --branch
    else
      while read -r path branch; do
        [ -n "${path:-}" ] || continue
        printf '\n%s (%s)\n' "$path" "${branch#refs/heads/}"
        git -C "$path" status --short --branch
      done < <(git worktree list --porcelain | awk '/^worktree / {p=$2} /^branch refs\/heads\/agent\// {print p, $2}')
    fi
    ;;
  remove)
    task=${1:?task slug required}; force=false
    [ "${2:-}" = "--force" ] && force=true
    branch=$(resolve_branch "$task") || exit 1
    path=$(worktree_line "$branch")
    [ -n "${path:-}" ] || { echo "branch is not checked out: $branch" >&2; exit 1; }
    dirty=false; is_dirty "$path" && dirty=true
    merged=false; remove_branch_safely "$branch" "$default_branch" >/dev/null 2>&1 && merged=true || true
    if [ "$force" != true ] && { [ "$dirty" = true ] || [ "$merged" != true ]; }; then
      echo "Refusing unsafe removal: branch=$branch dirty=$dirty merged-into-$default_branch=$merged" >&2
      echo "Inspect with agent-worktree status; use --force only after review." >&2
      exit 1
    fi
    [ "$dirty" = false ] || [ "$force" = true ] || exit 1
    if [ "$force" = true ]; then
      git -C "$path" submodule deinit --force --all >/dev/null 2>&1 || true
    elif ! git -C "$path" submodule deinit --all >/dev/null 2>&1; then
      echo "Refusing removal: a submodule could not be deinitialized cleanly." >&2
      exit 1
    fi
    # Git requires its force flag for worktrees that contain submodules. This
    # is safe here because dirty/ignored/unmerged state was checked above.
    git worktree remove --force "$path"
    if [ "$force" = true ]; then
      git branch -D "$branch"
    elif [ "$merged" = true ]; then
      # `git branch -d` compares against the current checkout, not the base
      # branch we verified above; use -D only after that explicit ancestry
      # check so removal works from any agent worktree.
      git branch -D "$branch"
    else
      echo "Refusing branch deletion because it is not merged." >&2
      exit 1
    fi
    ;;
  prune) git worktree prune --verbose ;;
  clean|cleanup-merged)
    force=false; [ "${1:-}" = "--force" ] && force=true
    if [ "$force" = true ]; then
      echo "cleanup-merged --force is disabled; use remove <full-branch> --force after inspection." >&2
      exit 2
    fi
    while read -r branch; do
      [ -n "$branch" ] || continue
      task=${branch##*/}; path=$(worktree_line "$branch")
      [ -n "${path:-}" ] || continue
      "$0" remove "$branch" || true
    done < <(git for-each-ref --format='%(refname:short)' "refs/heads/agent/*/*")
    ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
