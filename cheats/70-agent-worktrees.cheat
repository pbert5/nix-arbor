% git, agent worktrees

# List every checkout and its branch
git worktree list

# Identify the actual main checkout first; do not use a linked worktree as the root
git worktree list --porcelain

# Create below that main checkout only after verifying .worktrees is ignored
git -C "$MAIN_CHECKOUT" check-ignore -q .worktrees/probe &&
  git -C "$MAIN_CHECKOUT" worktree add -b agent/<agent>/<task> "$MAIN_CHECKOUT/.worktrees/agent-<agent>-<task>" HEAD

# Existing legacy helper worktrees stay in place; do not relocate active/dirty work

# Inspect agent checkout status
./scripts/agent-worktree status

# Remove only a clean, merged agent checkout
./scripts/agent-worktree remove <task-slug>

# Find merged branches before cleanup
git branch --merged main

# Remove stale Git worktree metadata; this does not remove live checkouts
git worktree prune

# Initialize Nix Arbor's direct component/reference submodules
git submodule update --init

# Initialize a child repository's own nested submodules when it declares them
git -C packages/<component> submodule update --init --recursive

# Run Codex or Claude in the current dedicated worktree
codex
claude
