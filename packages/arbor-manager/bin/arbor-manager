#!/usr/bin/env bash
# shellcheck disable=SC2016
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  arbor-manager machine export --snapshot FILE --name NODE [--format json|text]
  arbor-manager machine inspect --snapshot FILE --name NODE [--format json|text]
  arbor-manager nodes list --snapshot FILE
    [--scope all|local|selected|excluded|roots|children|descendants|parents|ancestors|peers|accessible]
    [--format table|names|json|ssh|colmena]
  arbor-manager deployment-plan --snapshot FILE [--format json|text]
  arbor-manager deployment plan --snapshot FILE [--format json|text]
  arbor-manager deployment apply --snapshot FILE [--acknowledgement DIGEST|TOKEN]
    [--backend-executable FILE] [--backend-timeout SECONDS]
    [--receipt FILE] [--resume FILE]
    [--dry-run] [--format json|text]
  arbor-manager identity inspect|import|rotate [--path FILE|--source DIR] [--output FILE]
  arbor-manager recovery inspect|export|import --path FILE [--output FILE]
  arbor-manager external-target inspect|manage --path FILE [--name NAME]
  arbor-manager doctor [--status FILE] [--format json|text]

All commands are offline and read an immutable deployment snapshot.
EOF
}

die() { echo "arbor-manager: $*" >&2; exit 2; }

command=${1:-}
shift || true
action=$command
if [ "$command" = -h ] || [ "$command" = --help ] || [ -z "$command" ]; then
  usage
  exit 0
fi
if [ "$command" = nodes ]; then
  subcommand=${1:-}
  shift || true
  [ "$subcommand" = list ] || { usage; exit 2; }
elif [ "$command" = machine ]; then
  subcommand=${1:-}
  shift || true
elif [ "$command" = deployment ]; then
  subcommand=${1:-}
  shift || true
elif [ "$command" = identity ] || [ "$command" = recovery ] || [ "$command" = external-target ]; then
  subcommand=${1:-}
  shift || true
fi

snapshot_file=
format=json
name=
scope=all
acknowledgement=
dry_run=false
backend_executable=
backend_timeout=300
receipt_file=
resume_file=
input_file=
output_file=
status_file=/run/arbor/doctor/status.json
runtime_executable=
target_name=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --snapshot) [ "$#" -ge 2 ] || die "--snapshot requires a file"; snapshot_file=$2; shift 2 ;;
    --format) [ "$#" -ge 2 ] || die "--format requires a value"; format=$2; shift 2 ;;
    --name) [ "$#" -ge 2 ] || die "--name requires a node"; name=$2; shift 2 ;;
    --scope) [ "$#" -ge 2 ] || die "--scope requires a value"; scope=$2; shift 2 ;;
    --acknowledgement|--acknowledgement-token) [ "$#" -ge 2 ] || die "$1 requires a value"; acknowledgement=$2; shift 2 ;;
    --backend-executable) [ "$#" -ge 2 ] || die "--backend-executable requires a file"; backend_executable=$2; shift 2 ;;
    --backend-timeout) [ "$#" -ge 2 ] || die "--backend-timeout requires seconds"; backend_timeout=$2; shift 2 ;;
    --receipt) [ "$#" -ge 2 ] || die "--receipt requires a file"; receipt_file=$2; shift 2 ;;
    --resume) [ "$#" -ge 2 ] || die "--resume requires a receipt file"; resume_file=$2; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    --path|--source|--input) [ "$#" -ge 2 ] || die "$1 requires a file or directory"; input_file=$2; shift 2 ;;
    --output) [ "$#" -ge 2 ] || die "--output requires a file"; output_file=$2; shift 2 ;;
    --status) [ "$#" -ge 2 ] || die "--status requires a file"; status_file=$2; shift 2 ;;
    --runtime-executable|--adapter) [ "$#" -ge 2 ] || die "$1 requires a file"; runtime_executable=$2; shift 2 ;;
    --target) [ "$#" -ge 2 ] || die "--target requires a name"; target_name=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option '$1'" ;;
  esac
done

# Operator/runtime commands deliberately do not require a deployment snapshot.
# They operate on data files or an explicitly supplied adapter.  Adapters get
# JSON on stdin and must return JSON; this keeps the registry dependency at a
# stable wire boundary while its runtime API evolves independently.
# Keep this filter available to both snapshot inspection and operator commands.
redact_filter='
  def secret_key:
    ascii_downcase | gsub("[-_]"; "")
    | test("secret|password|passphrase|token|credential|private|signingkey|apikey|authorization|accesskey|seed");
  def unsafe_string:
    test("^(/nix/store/|/run/|/var/run/)")
    or test("-----BEGIN [^-]*PRIVATE KEY-----")
    or test("^[A-Za-z][A-Za-z0-9+.-]*://[^/?#[:space:]]+:[^/?#[:space:]]+@")
    or test("(^|[?&])(api[_-]?key|access[_-]?token|auth[_-]?token|credential|password|passphrase|secret|token)=[^&#[:space:]]+"; "i")
    or test("^Bearer[[:space:]]+[^[:space:]]+$"; "i");
  def redact:
    if type == "object" then with_entries(if (.key | secret_key) then .value = "<redacted>" else .value |= redact end)
    elif type == "array" then map(redact)
    elif type == "string" and unsafe_string then "<redacted>" else . end;
  redact
'
if [ "$command" = identity ] || [ "$command" = recovery ] || [ "$command" = external-target ]; then
  [ -n "$subcommand" ] || die "$command requires an action"
  [ "$format" = json ] || [ "$format" = text ] || die "unknown format '$format'"
  [ -n "$input_file" ] || die "$command $subcommand requires --path (or --source)"
  redact_json() { jq -cS "$redact_filter"; }
  secure_input() {
    [ -r "$1" ] || die "cannot read '$1'"
    [ -f "$1" ] || die "'$1' is not a regular file"
    # Private recovery material must not be group/world accessible.
    mode=$(stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1")
    case "$mode" in 600|400|640|440) ;; *) die "private input '$1' must have mode 0600 or 0400" ;; esac
  }
  resolve_input() {
    if [ -d "$input_file" ]; then
      for candidate in identity.json node-identity.json private/identity.json recovery.json targets.json; do
        [ -f "$input_file/$candidate" ] && { input_file=$input_file/$candidate; break; }
      done
    fi
    secure_input "$input_file"
  }
  resolve_input
  payload=$(jq -e -cS . "$input_file") || die "invalid JSON in '$input_file'"
  [ -n "$target_name" ] || target_name=$name
  if [ "$command" = identity ] && [ "$subcommand" = rotate ]; then
    [ -n "$runtime_executable" ] || die "identity rotate requires --runtime-executable; registry runtime contract unavailable"
  fi
  if [ "$subcommand" = manage ] || [ "$subcommand" = rotate ] || [ "$subcommand" = import ] || { [ "$command" = recovery ] && [ "$subcommand" != import ] && [ -n "$runtime_executable" ]; }; then
    [ -n "$runtime_executable" ] || die "$command $subcommand requires --runtime-executable"
    [ -x "$runtime_executable" ] || die "runtime adapter '$runtime_executable' is not executable"
    request=$(jq -n -cS --arg operation "$command/$subcommand" --argjson data "$payload" '{protocol:"arbor-manager/runtime-adapter",version:1,operation:$operation,data:$data}')
    response=$(printf '%s\n' "$request" | env -i PATH="${PATH:-/usr/bin:/bin}" "$runtime_executable") || die "runtime adapter failed (contract mismatch or runtime unavailable)"
    jq -e -cS "$redact_filter | select(type == \"object\")" <<<"$response" >/dev/null || die "runtime adapter returned a non-object JSON response (contract mismatch)"
    if [ "$format" = json ]; then redact_json <<<"$response"; else jq -r 'to_entries[] | "\(.key)=\(.value|tostring)"' <<<"$(redact_json <<<"$response")"; fi
    exit 0
  fi
  if [ "$command" = external-target ] && [ "$subcommand" = inspect ]; then
    [ -n "$target_name" ] && payload=$(jq -e -cS --arg name "$target_name" '.[$name] // .targets[$name] // .target[$name] // .target // error("unknown target")' <<<"$payload") || true
  fi
  result=$(jq -n -cS --arg operation "$command/$subcommand" --argjson data "$payload" '{format:"arbor-manager/operator",version:1,operation:$operation,data:$data}' | redact_json)
  if [ "$format" = json ]; then printf '%s\n' "$result"; else jq -r '"\(.operation // .status)", (.data // {} | to_entries[] | "  \(.key)=\(.value|tostring)")' <<<"$result"; fi
  exit 0
fi

if [ "$command" = doctor ]; then
  if [ -r "$status_file" ]; then
    doctor=$(jq -e -cS "$redact_filter" "$status_file") || die "invalid doctor status JSON '$status_file'"
  else
    doctor=$(jq -n -cS --arg path "$status_file" '{version:1,status:"unknown",healthy:false,reason:"runtime status file unavailable",statusPath:$path}')
  fi
  healthy=$(jq -r 'if (.healthy? == true or (.status? == "healthy")) then "true" else "false" end' <<<"$doctor")
  if [ "$format" = json ]; then printf '%s\n' "$doctor"; else jq -r '"doctor status=" + (.status // "unknown"), (if .reason then "reason=" + .reason else empty end)' <<<"$doctor"; fi
  [ "$healthy" = true ] || exit 1
  exit 0
fi

if [ "$command" = tui ]; then
  die "tui is not available; use inspect/list commands"
fi

[ -n "$snapshot_file" ] || die "--snapshot is required"
[ -r "$snapshot_file" ] || die "cannot read snapshot '$snapshot_file'"
case "$format" in json|text|table|names|ssh|colmena) ;; *) die "unknown format '$format'" ;; esac
case "$backend_timeout" in ''|*[!0-9]*|0) die "--backend-timeout must be a positive integer" ;; esac

case "$command" in
  machine)
    [ "$subcommand" = export ] || [ "$subcommand" = inspect ] || die "unknown machine command '$subcommand'"
    action=$subcommand
    [ -n "$name" ] || die "machine commands require --name"
    ;;
  nodes)
    case "$scope" in all|local|selected|excluded|roots|children|descendants|parents|ancestors|peers|accessible) ;; *) die "unknown node scope '$scope'" ;; esac
    ;;
  deployment-plan) command=deployment-plan ;;
  deployment)
    case "$subcommand" in
      plan) command=deployment-plan ;;
      apply) command=deployment-apply ;;
      *) die "unknown deployment command '$subcommand'" ;;
    esac
    ;;
  *) usage; exit 2 ;;
esac

snapshot=$(jq -e -cS 'select(.format == "arbor-manager/deployment-snapshot" and .version == 1 and (.snapshot | type) == "object")' "$snapshot_file") || die "invalid deployment snapshot"

# Hashes are checked against canonical JSON, which is the representation used
# by lib.snapshot.  This makes the CLI reject edited or partially copied files.
expected_snapshot_digest=$(jq -r '.snapshotDigest' <<<"$snapshot")
actual_snapshot_digest=$(jq -cS '.snapshot' <<<"$snapshot" | sha256sum | cut -d' ' -f1)
[ "$expected_snapshot_digest" = "$actual_snapshot_digest" ] || die "snapshotDigest does not match snapshot contents"
expected_digest=$(jq -r '.digest' <<<"$snapshot")
actual_digest=$(jq -cS 'del(.digest)' <<<"$snapshot" | sha256sum | cut -d' ' -f1)
[ "$expected_digest" = "$actual_digest" ] || die "digest does not match snapshot contents"

# A valid digest proves snapshot integrity, not that its machine records are
# safe to print. Keep this boundary independent of Nix evaluation so imported
# snapshots cannot smuggle executable values, paths, or credentials into
# offline inspection and export output.
redact_filter='
  def secret_key:
    ascii_downcase
    | gsub("[-_]"; "")
    | test("secret|password|passphrase|token|credential|private|signingkey|apikey|authorization|accesskey|seed");
  def unsafe_string:
    test("^(/nix/store/|/run/|/var/run/)")
    or test("-----BEGIN [^-]*PRIVATE KEY-----")
    or test("^[A-Za-z][A-Za-z0-9+.-]*://[^/?#[:space:]]+:[^/?#[:space:]]+@")
    or test("(^|[?&])(api[_-]?key|access[_-]?token|auth[_-]?token|credential|password|passphrase|secret|token)=[^&#[:space:]]+"; "i")
    or test("^Bearer[[:space:]]+[^[:space:]]+$"; "i");
  def redact:
    if type == "object" then
      with_entries(if (.key | secret_key) then .value = "<redacted>" else .value |= redact end)
    elif type == "array" then map(redact)
    elif type == "string" and unsafe_string then "<redacted>"
    else .
    end;
  redact
'

refuse() { echo "arbor-manager: deployment application refused: $*" >&2; exit 3; }

run_direct_backend() {
  [ -n "$backend_executable" ] || refuse "no deployment backend configured; provide --backend-executable or use --dry-run"
  [ -f "$backend_executable" ] && [ -x "$backend_executable" ] || refuse "backend executable '$backend_executable' is not an executable file"
  backend_name=$(jq -r '.plan.backend' <<<"$snapshot")
  case "$backend_name" in direct|colmena) ;; *) refuse "unsupported deployment backend '$backend_name'" ;; esac

  work=$(mktemp -d)
  trap 'rm -rf "$work"' RETURN
  phase_count=$(jq '.plan.phases | length' <<<"$snapshot")
  selected=$(jq -c '.snapshot.selected' <<<"$snapshot")
  planned=$(jq -c '[.plan.phases[].names[] | if type == "array" then .[] else . end]' <<<"$snapshot")
  jq -e --argjson selected "$selected" --argjson planned "$planned" '
    (.snapshot.selected | type == "array")
    and all($selected[]; type == "string")
    and (.plan.phases | type == "array")
    and all(.plan.phases[];
      (.name | type == "string")
      and (.names | type == "array")
      and ((.names | length) > 0)
      and all(.names[]; (type == "string") or (type == "array" and length > 0 and all(.[]; type == "string"))))
    and (([.plan.phases[].name] | length) == ([.plan.phases[].name] | unique | length))
    and (($planned | sort) == ($selected | sort))
    and (. as $root
      | ((.plan.phases | to_entries
        | map(.key as $index | .value.names[] as $entry
          | (if ($entry | type) == "array" then $entry[] else $entry end)
          | {key: ., value: $index}) | from_entries) as $positions
      | all($selected[]; . as $name |
          (($root.snapshot.nodes[$name].parents // [])
            | all(.[]; . as $parent | ($positions[$parent] // -1) <= ($positions[$name] // 0))))))
  ' <<<"$snapshot" >/dev/null || refuse "deployment phases are incomplete, duplicated, malformed, or violate graph ordering"
  jq -e --argjson selected "$selected" '. as $root | all($selected[]; . as $name |
    ($root.snapshot.nodes[$name] != null)
    and (($root.snapshot.nodes[$name] | {
      host: (.targetHost // .target.targetHost // .hostname // $name),
      port: (.targetPort // .target.targetPort // null),
      user: (.targetUser // .target.targetUser // null)
    }) as $endpoint | ($endpoint.host | type == "string" and length > 0 and test("^[A-Za-z0-9._:-]+$")) and ($endpoint.port == null or ($endpoint.port | type == "number" and floor == . and . >= 1 and . <= 65535)) and ($endpoint.user == null or ($endpoint.user | type == "string" and length > 0 and test("^[A-Za-z0-9._-]+$")))))' <<<"$snapshot" >/dev/null || refuse "deployment phases reference nodes absent from or with invalid endpoint identity in the immutable snapshot"

  if [ -n "$resume_file" ]; then
    [ -r "$resume_file" ] || refuse "cannot read resume receipt '$resume_file'"
    jq -e --slurpfile snapshot "$snapshot_file" --arg snapshotDigest "$(jq -r .snapshotDigest <<<"$snapshot")" --arg acknowledgementDigest "$(jq -r .acknowledgement.digest <<<"$snapshot")" '
      type == "object" and .format == "arbor-manager/deployment-receipt" and .version == 1
      and .snapshotDigest == $snapshotDigest and .acknowledgementDigest == $acknowledgementDigest
      and (.results | type == "array")
      and all(.results[]; (.phase | type == "string") and (.node | type == "string") and (.status == "succeeded") and (.provider | type == "object"))
      and ([.results[] | (.phase + "\u0000" + .node)] | length == (unique | length))
      and all(.results[]; . as $result | any($snapshot[0].plan.phases[]; .name == $result.phase and any(.names[]; (if type == "array" then .[] else . end) == $result.node)))
    ' "$resume_file" >/dev/null || refuse "resume receipt identity is not bound to this immutable snapshot and acknowledgement"
    resume_results=$(jq -c '.results' "$resume_file")
  else
    resume_results='[]'
  fi

  write_receipt() {
    [ -n "$receipt_file" ] || return 0
    receipt_tmp="$work/receipt.tmp"
    jq -n -cS --arg snapshotDigest "$(jq -r .snapshotDigest <<<"$snapshot")" --arg acknowledgementDigest "$(jq -r .acknowledgement.digest <<<"$snapshot")" --argjson results "$results" '{format: "arbor-manager/deployment-receipt", version: 1, status: (if all($results[]; .status == "succeeded") then "applied" else "partial" end), snapshotDigest: $snapshotDigest, acknowledgementDigest: $acknowledgementDigest, results: $results}' >"$receipt_tmp"
    mv -f "$receipt_tmp" "$receipt_file"
  }

  results='[]'
  phase=0
  while [ "$phase" -lt "$phase_count" ]; do
    phase_name=$(jq -r --argjson phase "$phase" '.plan.phases[$phase].name // ("phase-" + ($phase + 1 | tostring))' <<<"$snapshot")
    names=$(jq -c --argjson phase "$phase" '[.plan.phases[$phase].names[] | if type == "array" then .[] else . end]' <<<"$snapshot")
    node_count=$(jq 'length' <<<"$names")
    node=0
    while [ "$node" -lt "$node_count" ]; do
      node_name=$(jq -r --argjson node "$node" '.[$node]' <<<"$names")
      request=$(jq -S -c --arg backend "$backend_name" --arg phase "$phase_name" --arg node "$node_name" '
        .snapshot.nodes[$node] as $record
        | ($record.target // {}) as $target
        | {
            protocol: "arbor-manager/direct-backend-request",
            version: 1,
            backend: $backend,
            snapshotDigest: .snapshotDigest,
            acknowledgementDigest: .acknowledgement.digest,
            phase: $phase,
            node: $node,
            endpoint: {
              host: ($record.targetHost // $target.targetHost // $record.hostname // $node),
              port: ($record.targetPort // $target.targetPort // null),
              user: ($record.targetUser // $target.targetUser // null)
            },
            risk: ($record.risk // $record.risks // {
              critical: ($record.critical // false),
              criticalRoute: ($record.criticalRoute // false),
              state: ($record.state // "active")
            })
          }
      ' <<<"$snapshot")
      safe_request=$(jq -S -c "$redact_filter" <<<"$request")
      [ "$safe_request" = "$request" ] || refuse "deployment endpoint metadata for '$node_name' contains a secret-like value"
      if jq -e --arg phase "$phase_name" --arg node "$node_name" --argjson endpoint "$(jq -c .endpoint <<<"$request")" --argjson risk "$(jq -c .risk <<<"$request")" 'any(.[]; .phase == $phase and .node == $node and .status == "succeeded" and (.provider | type == "object") and .endpoint == $endpoint and (.risk // {}) == $risk)' <<<"$resume_results" >/dev/null; then
        provider=$(jq -c --arg phase "$phase_name" --arg node "$node_name" 'map(select(.phase == $phase and .node == $node))[0].provider' <<<"$resume_results")
        results=$(jq -cS --arg phase "$phase_name" --arg node "$node_name" --argjson endpoint "$(jq -c .endpoint <<<"$request")" --argjson risk "$(jq -c .risk <<<"$request")" --argjson provider "$provider" '. + [{phase: $phase, node: $node, endpoint: $endpoint, risk: $risk, status: "succeeded", resumed: true, provider: $provider}]' <<<"$results")
        node=$((node + 1))
        continue
      fi
      request_file=$work/request-$phase-$node.json
      output_file=$work/output-$phase-$node.json
      error_file=$work/error-$phase-$node.txt
      provider_file=$work/provider-$phase-$node.json
      result_file=$work/result-$phase-$node.json
      printf '%s\n' "$request" >"$request_file"
      if (ulimit -f 1024; setsid timeout --signal=TERM --kill-after=5 "${backend_timeout}s" env -i PATH="$PATH" HOME="${HOME:-/nonexistent}" ARBOR_MANAGER_BACKEND="$backend_name" "$backend_executable" <"$request_file" >"$output_file" 2>"$error_file"); then
        if jq -e -cS "$redact_filter | select(type == \"object\")" "$output_file" >"$provider_file" 2>/dev/null; then
          if jq -e --arg backend "$backend_name" --arg phase "$phase_name" --arg node "$node_name" --arg snapshotDigest "$(jq -r .snapshotDigest <<<"$snapshot")" --arg acknowledgementDigest "$(jq -r .acknowledgement.digest <<<"$snapshot")" --argjson endpoint "$(jq -c .endpoint "$request_file")" --argjson risk "$(jq -c .risk "$request_file")" 'type == "object" and .status == "succeeded" and .backend == $backend and .phase == $phase and .node == $node and .endpoint == $endpoint and (.risk // {}) == $risk and .snapshotDigest == $snapshotDigest and .acknowledgementDigest == $acknowledgementDigest' "$provider_file" >/dev/null; then
            jq -n -cS --arg phase "$phase_name" --arg node "$node_name" --slurpfile request "$request_file" --slurpfile provider "$provider_file" '{phase: $phase, node: $node, endpoint: $request[0].endpoint, risk: $request[0].risk, status: "succeeded", provider: $provider[0]}' >"$result_file"
          else
            jq -n -cS --arg phase "$phase_name" --arg node "$node_name" '{phase: $phase, node: $node, status: "failed", error: "backend response did not confirm request identity or success"}' >"$result_file"
          fi
        else
          jq -n -cS --arg phase "$phase_name" --arg node "$node_name" '{phase: $phase, node: $node, status: "failed", error: "backend returned invalid JSON"}' >"$result_file"
        fi
      else
        exit_code=$?
        jq -n -cS --arg phase "$phase_name" --arg node "$node_name" --argjson exitCode "$exit_code" '{phase: $phase, node: $node, status: "failed", error: "backend exited unsuccessfully", exitCode: $exitCode}' >"$result_file"
      fi
      results=$(jq -cS --slurpfile result "$result_file" '. + [$result[0]]' <<<"$results")
      write_receipt
      if [ "$(jq -r .status "$result_file")" != succeeded ]; then
        jq -S --argjson results "$results" --arg receipt "$receipt_file" '{status: (if any($results[]; .status == "succeeded") then "partial" else "failed" end), applied: false, snapshotDigest, acknowledgementDigest: .acknowledgement.digest, results: $results, receipt: (if $receipt == "" then null else $receipt end)}' <<<"$snapshot"
        return 4
      fi
      node=$((node + 1))
    done
    phase=$((phase + 1))
  done

  write_receipt
  jq -S --argjson results "$results" --arg receipt "$receipt_file" '{status: (if all($results[]; .status == "succeeded") then "applied" else "partial" end), applied: (all($results[]; .status == "succeeded")), snapshotDigest, acknowledgementDigest: .acknowledgement.digest, results: $results, receipt: (if $receipt == "" then null else $receipt end)}' <<<"$snapshot"
  jq -e 'all(.results[]; .status == "succeeded")' <<<"$(jq -S --argjson results "$results" '{results: $results}' <<<"$snapshot")" >/dev/null
}

if [ "$command" = deployment-apply ] && [ "$dry_run" = true ]; then
  if [ "$format" = json ]; then
    jq -S '{status: "dry-run", applied: false, snapshotDigest, plan, acknowledgement}' <<<"$snapshot"
  else
    jq -r '"deployment dry-run", "snapshot=" + .snapshotDigest, "backend=" + (.plan.backend // "unknown"), "selected=" + (.snapshot.selected | join(", "))' <<<"$snapshot"
  fi
  exit 0
fi

if [ "$command" = deployment-apply ]; then
  [ -n "$acknowledgement" ] || refuse "acknowledgement is required; use --dry-run to inspect the plan"
  [ "$(jq -r '.plan.backend // empty' <<<"$snapshot")" != "" ] || refuse "snapshot has no immutable deployment plan"
  expected_ack=$(jq -r '.acknowledgement.digest // empty' <<<"$snapshot")
  expected_token=$(jq -r '.acknowledgement.token // empty' <<<"$snapshot")
  [ -n "$expected_ack" ] || refuse "snapshot has no immutable acknowledgement digest"
  actual_plan_digest=$(jq -cS '{snapshotDigest, phases: .plan.phases, risks: (.plan.risks // []), backend: .plan.backend}' <<<"$snapshot" | sha256sum | cut -d' ' -f1)
  [ "$actual_plan_digest" = "$expected_ack" ] || refuse "immutable acknowledgement digest is inconsistent with the plan and snapshot"
  if [ "$acknowledgement" != "$expected_ack" ] && [ "$acknowledgement" != "$expected_token" ]; then
    refuse "acknowledgement does not match the immutable plan and snapshot (expected digest $expected_ack)"
  fi
  if [ "$format" = json ]; then
    if ! run_direct_backend; then exit 4; fi
  else
    if ! results=$(run_direct_backend); then
      jq -r '"deployment failed", "snapshot=" + .snapshotDigest, (.results[] | "  " + .phase + ":" + .node + "=" + .status)' <<<"$results"
      exit 4
    fi
    jq -r '"deployment " + .status, "snapshot=" + .snapshotDigest, (.results[] | "  " + .phase + ":" + .node + "=" + .status)' <<<"$results"
  fi
  exit 0
fi

machine_json() {
  jq -e --arg name "$name" "$redact_filter | .snapshot.nodes[\$name] // error(\"unknown node\")" <<<"$snapshot"
}

# shellcheck disable=SC2016
inspect_filter='
  {
    format: "arbor-manager/machine-inspect",
    version: 1,
    name: $name,
    record: .,
    provenance: {
      source: (.provenance // {kind: "snapshot"}),
      fields: (to_entries | map({key: .key, value: {field: .key, source: (if (.value | type) == "object" then (.value.provenance // {kind: "snapshot"}) else {kind: "snapshot"} end)}}) | from_entries)
    }
  }
'

if [ "$command" = machine ]; then
  record=$(machine_json) || die "unknown node '$name'"
  if [ "$action" = export ]; then
    if [ "$format" = json ]; then
      jq -S . <<<"$record"
    else
      jq -r 'to_entries[] | "\(.key)=\(.value|tostring)"' <<<"$record"
    fi
  else
    inspected=$(jq -S --arg name "$name" "$redact_filter | $inspect_filter | redact" <<<"$record")
    if [ "$format" = json ]; then
      jq -S . <<<"$inspected"
    else
      jq -r '"machine \(.name)", (.record | to_entries[] | "  \(.key)=\(.value|tostring)"), "provenance=" + (.provenance.source | tostring)' <<<"$inspected"
    fi
  fi
elif [ "$command" = nodes ]; then
  case "$scope" in
    all) names_filter='.snapshot.nodes | keys' ;;
    local|roots) names_filter='.snapshot.roots' ;;
    selected) names_filter='.snapshot.selected' ;;
    excluded) names_filter='.snapshot.excluded | map(.name) | sort' ;;
    children|descendants|parents|ancestors|peers|accessible)
      # shellcheck disable=SC2016
      names_filter='.
        | .snapshot as $s
        | ($s.nodes // {}) as $nodes
        | ($s.roots // []) as $roots
        | def rel($name; $kind):
            if $kind == "children" then
              (($nodes[$name].children // []) + ([$nodes | to_entries[] | select((.value.parents // []) | index($name)) | .key]) | unique | sort)
            else
              (($nodes[$name].parents // []) + ([$nodes | to_entries[] | select((.value.children // []) | index($name)) | .key]) | unique | sort)
            end;
          def walk($frontier; $seen; $kind):
            if ($frontier | length) == 0 then $seen
            else
              ([$frontier[] as $name | rel($name; $kind)[]] | unique) as $next
              | walk([$next[] | select(($seen | index(.)) | not)]; ($seen + $next) | unique; $kind)
            end;
          if "SCOPE" == "children" then [$roots[] as $r | rel($r; "children")[]] | unique | sort
          elif "SCOPE" == "parents" then [$roots[] as $r | rel($r; "parents")[]] | unique | sort
          elif "SCOPE" == "descendants" then (walk($roots; []; "children") - $roots) | sort
          elif "SCOPE" == "ancestors" then (walk($roots; []; "parents") - $roots) | sort
          elif "SCOPE" == "accessible" then (walk($roots; $roots; "children") + walk($roots; $roots; "parents") | unique | sort)
          else
            ([$roots[] as $r | rel($r; "children")[]] + [$roots[] as $r | rel($r; "parents")[]] | unique | sort)
          end'
      names_filter=${names_filter//SCOPE/$scope} ;;
  esac
  names=$(jq -c "$names_filter" <<<"$snapshot")
  if [ "$format" = json ]; then
    jq -S --argjson names "$names" '{scope: $scope, names: $names}' --arg scope "$scope" <<<"$snapshot"
  elif [ "$format" = table ]; then
    printf 'NAME\tHOST\tSYSTEM\tSTATE\n'
    jq -r --argjson names "$names" '.snapshot.nodes as $nodes | $names[] | . as $name | $nodes[$name] as $node | [$name, ($node.targetHost // $node.hostname // "-"), ($node.system // "-"), ($node.state // "active")] | @tsv' <<<"$snapshot" | column -t -s $'\t'
  elif [ "$format" = ssh ]; then
    jq -r --argjson names "$names" '.snapshot.nodes as $nodes | $names[] | . as $name | $nodes[$name] as $node | (($node.targetUser // "root") + "@" + ($node.targetHost // $node.hostname // $name))' <<<"$snapshot"
  else
    jq -r '.[]' <<<"$names"
  fi
else
  if [ "$format" = json ]; then
    jq -S . <<<"$snapshot"
  else
    jq -r '"deployment snapshot \(.snapshotDigest)", "selector=\(.snapshot.selector)", "selected=\(.snapshot.selected | join(", "))", "excluded=\(.snapshot.excluded | map(.name + ":" + (.reasons | join(","))) | join("; "))"' <<<"$snapshot"
  fi
fi
