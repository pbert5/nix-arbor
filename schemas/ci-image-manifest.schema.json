{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pbert5/nix-arbor/schemas/ci-image-manifest.schema.json",
  "title": "Nix Arbor CI image manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "images"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "context", "dockerfile", "platforms"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "context": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
          "dockerfile": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "contains": { "const": "linux/amd64" },
            "items": { "const": "linux/amd64" }
          },
          "buildArgs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "not": { "pattern": "(^|_)(SECRET|TOKEN|PASSWORD|CREDENTIAL|KEY|AUTH|BEARER|PASSPHRASE|CERTIFICATE)($|_)" }
            },
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    }
  }
}
